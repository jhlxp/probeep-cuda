# H20 multi-node execution contract. Copy this file and edit cluster-only values.

export NNODES=2
export GPUS_PER_NODE=8
export NUM_EXPERTS=256
export TOKENS_PER_RANK=4096
export TOPK=8
export HIDDEN=7168
export PROBEEP_TOPOLOGY_TAG=${NNODES}n${GPUS_PER_NODE}g_h20

# Target H20 fabric: four 400-Gbps physical NICs, each exposed as two
# independent 200-Gbps GPU-facing rails.  ProbeEP budgets one local rank/rail;
# never pass the 3.2-Tbps server aggregate into the per-rail controller.
export PROBEEP_PHYSICAL_NICS_PER_SERVER=4
export PROBEEP_RAILS_PER_PHYSICAL_NIC=2
export PROBEEP_PHYSICAL_NIC_BANDWIDTH_GBPS=400
export PROBEEP_RDMA_PATH_BANDWIDTH_GBPS=200
export RDMA_PATH_BANDWIDTH_GBPS=200

# One Slurm task is launched per node; each task starts eight local GPU ranks.
export SLURM_PARTITION=long
export SLURM_TIME=04:00:00
export SLURM_CPUS_PER_TASK=192
export SLURM_MEM_MB=1937152
# export SLURM_NODELIST=h20-node-[01-02]
# export SLURM_QOS=normal

export MASTER_PORT=29500
export PROBEEP_REQUIRE_GPU_NAME=H20
export PROBEEP_REQUIRE_CLEAN_TREE=1
export PROBEEP_MIN_FREE_GPU_GIB=48
export TORCH_CUDA_ARCH_LIST=9.0
export CUDA_MODULE_LOADING=EAGER
export ULTRAEP_REPLICA_SLOTS=2
export NVSHMEM_DISABLE_CUDA_VMM=1
export NVSHMEM_IB_ENABLE_IBGDA=1
export NVSHMEM_REMOTE_TRANSPORT=ibrc
export NVSHMEM_SYMMETRIC_SIZE=3000000000
export NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME=eth0
# Set these from the target machine topology; never copy values from another cluster.
# Four active physical HCA ports are required.  Keep their order consistent
# with local rail pairs: rails 0/1 -> HCA0, 2/3 -> HCA1, 4/5 -> HCA2,
# 6/7 -> HCA3.  Replace these names/ports from ibdev2netdev/ibv_devinfo.
# export NVSHMEM_HCA_LIST=mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_3:1
# export NCCL_SOCKET_IFNAME=eth0
# export NCCL_IB_HCA=mlx5_0,mlx5_1,mlx5_2,mlx5_3

# Set PROBEEP_APPTAINER_IMAGE to run this Test in a shared read-only SIF.
# NVSHMEM_HOST_DIR is mounted read-only at NVSHMEM_CONTAINER_DIR.
# export PROBEEP_APPTAINER_IMAGE=/shared/path/runtime.sif
# export NVSHMEM_HOST_DIR=/host/path/to/nvidia/nvshmem
export NVSHMEM_CONTAINER_DIR=/opt/nvshmem

# HybridEP multinode backend. "nixl" requires NIXL/UCX; "doca" requires
# DOCA/RDMA-core plus locked NCCL source under HybridEP/third-party/nccl.
export HYBRID_EP_TRANSPORT=nixl
export NIXL_HOME=/usr/local/nixl
export UCX_HOME=/usr
# export RDMA_CORE_HOME=/usr
# export DOCA_HOME=/opt/mellanox/doca
# The DOCA build exports the pinned NCCL commit into this project's build/.
# export ULTRAEP_HYBRIDEP_ROOT=${PROBEEP_ROOT}/build/ultraep-hybridep-e0a5b1d9
# Optional: copy ABI-validated extensions from a project-local reuse seed.
# export ULTRAEP_REUSE_EXTENSION=${PROBEEP_ROOT}/build/reuse-seed/_C.cpython-312-x86_64-linux-gnu.so
# export HYBRIDEP_REUSE_EXTENSION=${PROBEEP_ROOT}/build/reuse-seed/hybrid_ep_cpp.cpython-312-x86_64-linux-gnu.so
# export HYBRIDEP_NCCL_GIT_DIR=/path/to/read-only/nccl.git
# HybridEP stages only the two RDMA links; the full host directory is not in RUNPATH.
# export HYBRIDEP_RDMA_INCLUDE_DIR=/usr/include
# export HYBRIDEP_HOST_LIBRARY_DIR=/lib/x86_64-linux-gnu
# export HYBRIDEP_CONTAINER_LIBRARY_DIR=/opt/probeep-host-rdma/lib
# export HYBRIDEP_RDMA_LIBRARY_DIR=${HYBRIDEP_CONTAINER_LIBRARY_DIR}

# Default project-local environment. It must be created independently on H20.
export VENV_DIR=${PROBEEP_TEST_DIR}/.venv-h20
export TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Debug correctness sizes. Formal performance remains 4096 tokens/rank.
export PROBEEP_SMOKE_TOKENS=256
export PROBEEP_EXPERT_IO_TOKENS=64
export PROBEEP_BACKWARD_TOKENS=64
export PROBEEP_TEST_SEED=20260813
export PROBEEP_TEST_ROUNDS=2

# Paper default: every measured invocation changes layer/version identity so
# the three-slot runtime ring cannot turn a 20/58-layer wavefront into a fake
# same-layer cache hit.  Set steady only for an explicitly labelled cache-hit
# sensitivity run.
export PROBEEP_WEIGHT_CACHE_MODE=cold

# DSV3 MLA attention-core producer for each 2048-token microbatch.
export PROBEEP_ATTENTION_HEADS=128
export PROBEEP_ATTENTION_QK_HEAD_DIM=192
export PROBEEP_ATTENTION_V_HEAD_DIM=128

# The Test entry owns the formal scheduler, measured observation mode,
# materialized manifest and immutable case plan. Do not override them here.
# Paper mode accepts only raw_data1_all; Test 01 sets it to 0 for eval20.
export PROBEEP_WORKLOAD_SELECTOR="${PROBEEP_WORKLOAD_SELECTOR:-raw_data1_all}"
export PROBEEP_FORMAL_PAPER_MODE="${PROBEEP_FORMAL_PAPER_MODE:-1}"
# This Test 01 run.sh generates and exports PROBEEP_BENCHMARK_PLAN automatically.
